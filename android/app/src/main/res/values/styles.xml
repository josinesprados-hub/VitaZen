<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main application theme (used by all activities except LauncherActivity) -->
    <style name="Theme.VitaZen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- LauncherActivity theme - uses AppCompat directly to avoid Theme.SplashScreen -->
    <!-- crash on Android 12+ real devices. androidbrowserhelper:2.5.0 handles splash -->
    <!-- via SPLASH_IMAGE_DRAWABLE meta-data with its own SimpleSplashScreenStrategy. -->
    <!-- On Android 12+, the system shows a default splash based on the app icon, then -->
    <!-- androidbrowserhelper shows its splash while the TWA is connecting. -->
    <style name="Theme.LauncherActivity" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
</resources>
