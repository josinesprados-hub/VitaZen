<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main application theme (used by all activities except LauncherActivity) -->
    <style name="Theme.VitaZen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- LauncherActivity theme. Uses AppCompat directly.
         The splash screen is handled by androidbrowserhelper's
         SimpleSplashScreenStrategy via SPLASH_IMAGE_DRAWABLE meta-data.
         On Android 12+, the system splash (app icon + windowBackground) shows first,
         then the library's splash (VitaZen logo) takes over seamlessly.
         On Android < 12, only the library's splash is shown. -->
    <style name="Theme.LauncherActivity" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
        <!-- colorPrimary set to black (not golden) so that if Chrome Custom Tabs fallback
             is triggered, the CCT toolbar blends with the dark UI instead of showing
             a golden bar. In TWA mode the toolbar is hidden entirely. -->
        <item name="colorPrimary">@color/backgroundColor</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>
</resources>
