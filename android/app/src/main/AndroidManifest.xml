<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Critical for Android 11+: enables discovery of Chrome Custom Tabs service.
         androidbrowserhelper:2.5.0 does NOT include this query in its own manifest,
         so queryIntentServices(CustomTabsService) returns empty on API 30+,
         preventing TWA/CCT provider detection and causing black screen crash. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- TwaProviderPicker.pickProvider() queries browsers with http scheme.
             The AAR only declares https, which can cause queryIntentActivities
             to return empty on Android 11+ for the http-scheme query. Adding
             http scheme ensures Chrome is found by pickProvider(). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/appName"
        android:supportsRtl="true"
        android:theme="@style/Theme.VitaZen"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <meta-data
            android:name="asset_statements"
            android:resource="@string/assetStatements" />

        <!-- Using custom SafeLauncherActivity instead of the library's
             com.google.androidbrowserhelper.trusted.LauncherActivity.
             SafeLauncherActivity fixes: (1) QualityEnforcer crash when DAL
             verification fails, (2) black screen when no splash drawable,
             (3) wraps launch in try/catch for resilience. -->
        <activity
            android:name="com.vitazen.app.v1.SafeLauncherActivity"
            android:exported="true"
            android:label="@string/appName"
            android:theme="@style/Theme.LauncherActivity"
            android:launchMode="singleTask"
            android:alwaysRetainTaskState="true">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://vitazen.cc" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/backgroundColor" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/colorPrimaryDark" />
            <meta-data
                android:name="android.support.customtabs.trusted.SCREEN_ORIENTATION"
                android:value="unspecified" />
            <meta-data
                android:name="android.support.customtabs.trusted.FALLBACK_STRATEGY"
                android:value="customtabs" />
            <!-- ADDITIONAL_TRUSTED_ORIGINS removed. Chrome validates Digital Asset Links
                 for ALL trusted origins — if any origin fails, the entire TWA falls back
                 to Chrome Custom Tabs (showing the toolbar). vitazen.app was listed here
                 but does not serve assetlinks.json, causing TWA verification to fail.
                 Only vitazen.cc is now trusted. If vitazen.app needs TWA in the future,
                 serve assetlinks.json there and re-add this metadata. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/splash" />
            <!-- splash.xml now contains a BitmapDrawable layer (ic_launcher_foreground)
                 which provides valid intrinsic dimensions to the LayerDrawable.
                 This fixes the previous crash where Utils.convertDrawableToBitmap()
                 called Bitmap.createBitmap(-1, -1, ...) on a ColorDrawable-only
                 layer-list. The splash now shows the official VitaZen logo on all
                 Android versions (not just 12+ system splash). -->
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/backgroundColor" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="vitazen.cc" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.google.androidbrowserhelper.trusted.FocusActivity"
            android:exported="false" />

        <activity
            android:name="com.google.androidbrowserhelper.trusted.WebViewFallbackActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden" />

        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

    </application>
</manifest>
