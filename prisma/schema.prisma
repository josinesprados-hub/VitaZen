generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════
// USER & AUTH
// ═══════════════════════════════════════════

model User {
  id                String   @id @default(cuid())
  firebaseUid       String   @unique
  email             String   @unique
  name              String?
  avatarUrl         String?
  country           String?
  city              String?
  age               Int?
  bio               String?
  weeklyEmailSummary Boolean @default(true)
  dailyReminders    Boolean @default(false)
  privacyStatsVisible Boolean @default(false)
  plan              String   @default("FREE") // FREE | PREMIUM
  stripeCustomerId  String?  @unique
  emailVerified     Boolean  @default(false)
  onboardingCompleted Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions     Subscription[]
  aiThreads         AIThread[]
  aiUsage           AIUsage?
  wellnessLogs      WellnessLog[]
  meditationSessions MeditationSession[]
  journalEntries    JournalEntry[]
  dailyChallenges   UserChallenge[]
  habitLogs         HabitLog[]
  nutritionLogs     NutritionLog[]
  financeLogs       FinanceLog[]
  empireProgress    EmpireProgress[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  achievements      Achievement[]
  dailyCheckins     DailyCheckin[]
  onboardingData    OnboardingData?
}

// ═══════════════════════════════════════════
// ONBOARDING
// ═══════════════════════════════════════════

model OnboardingData {
  id              String   @id @default(cuid())
  userId          String   @unique
  goals           String   // JSON array of personal goals
  primaryFocus    String   // mente | disciplina | energia | riqueza
  stressLevel     Int      // 1-5
  energyLevel     Int      // 1-5
  focusLevel      Int      // 1-5
  initialHabits   String   // JSON array of habit names
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String   @unique
  stripePriceId        String
  status               String   @default("active") // active | canceled | past_due | incomplete
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════
// AI SYSTEM
// ═══════════════════════════════════════════

model AIThread {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Nueva conversación")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]

  @@index([userId, archived])
}

model AIMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String   // user | assistant
  content   String
  createdAt DateTime @default(now())

  thread AIThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model AIUsage {
  id        String   @id @default(cuid())
  userId    String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════
// CHALLENGES
// ═══════════════════════════════════════════

model DailyChallenge {
  id          String   @id @default(cuid())
  category    String   // disciplina | mentalidad | habitos | productividad | salud
  title       String
  description String
  difficulty  String   @default("medium") // easy | medium | hard
  createdAt   DateTime @default(now())

  userChallenges UserChallenge[]
}

model UserChallenge {
  id          String    @id @default(cuid())
  userId      String
  challengeId String
  completed   Boolean   @default(false)
  completedAt DateTime?
  date        DateTime

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id])

  @@unique([userId, date])
}

// ═══════════════════════════════════════════
// WELLNESS & TRACKING
// ═══════════════════════════════════════════

model WellnessLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  mood      Int      // 1-5
  energy    Int      // 1-5
  sleep     Int      // 1-5
  stress    Int      // 1-5
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model MeditationSession {
  id          String   @id @default(cuid())
  userId      String
  duration    Int      // minutes
  type        String   // guided | breathing | body_scan | mindfulness
  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  mood      Int?     // 1-5
  gratitude String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════
// EMPIRE-SPECIFIC TRACKING
// ═══════════════════════════════════════════

model HabitLog {
  id              String    @id @default(cuid())
  userId          String
  name            String
  description     String?
  frequency       String    @default("daily") // daily | weekly | custom
  streak          Int       @default(0)
  lastCompletedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  meals     String?  // JSON string with meal data
  water     Int      @default(0) // glasses
  calories  Int?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model FinanceLog {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  type        String   // income | expense
  category    String
  amount      Float
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ═══════════════════════════════════════════
// EMPIRE SYSTEM
// ═══════════════════════════════════════════

model EmpireProgress {
  id       String  @id @default(cuid())
  userId   String
  empire   String  // disciplina | mente | energia | riqueza | crecimiento
  level    Int     @default(1)
  xp       Int     @default(0)
  streak   Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, empire])
}

model EmpireTip {
  id        String   @id @default(cuid())
  empire    String   // disciplina | mente | energia | riqueza | crecimiento
  title     String
  content   String
  plan      String   @default("FREE") // FREE | PREMIUM
  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════
// ACHIEVEMENTS
// ═══════════════════════════════════════════

model Achievement {
  id          String   @id @default(cuid())
  userId      String
  key         String   // e.g. "meditation_7", "journal_first", "habits_10"
  unlockedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// ═══════════════════════════════════════════
// DAILY CHECK-IN
// ═══════════════════════════════════════════

model DailyCheckin {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime
  emotion     Int      // 1-5 emotional state
  energy      Int      // 1-5
  focus       Int      // 1-5
  stress      Int      // 1-5
  intention   String   // daily intention
  note        String?  // optional note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
